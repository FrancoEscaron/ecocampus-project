PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ecocampus
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Correo transaccional. Si falta SMTP_HOST, SMTP_USER o SMTP_PASS, el correo se imprime en la consola.
SITE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoCampus <no-responder@ecocampus.local>
ADMIN_EMAIL=
MAIL_MIN_GAP_MS=

# Alternativa a SMTP para servidores que bloquean los puertos de correo, como el plan gratuito de Render.
# Si estas dos variables existen, el envío usa la API de Mailtrap por HTTPS e ignora SMTP.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Asistente virtual con Gemini. La clave gratuita se crea en https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
